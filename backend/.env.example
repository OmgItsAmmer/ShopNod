# Copy to `.env`. Everything has a safe local default, so this file is optional for a first run.
# Without OPENAI_API_KEY every agent uses its rules fallback (labelled honestly in the UI).

# all Python services
APP_ENV=local
LOG_LEVEL=INFO
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL_AGENT=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
JWT_SIGNING_KEY=change-me-to-a-long-random-string
MCP_AGENT_TOKEN_SECRET=change-me-to-another-long-random-string
# Ed25519 private key, base64 (32 raw bytes). Generate: python -c "from shopnod_core.tokens import generate_qr_signing_key as g; print(g())"
QR_SIGNING_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shopnod.local
# FCM push to the Flutter app: service-account JSON, base64 (needs `pip install ".[push]"`)
FIREBASE_CREDENTIALS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT_NAME=shopnod_redemption
STRIPE_PRO_PRICE_ID=
STRIPE_METERED_PRICE_ID=
# Without an email key the magic link is printed in the api logs
EMAIL_PROVIDER_KEY=
SENTRY_DSN=
SHOP_WEB_URL=http://localhost:3000
SHOPPER_WEB_URL=http://localhost:3000/shopper
API_PUBLIC_URL=http://localhost:8000
MCP_PUBLIC_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# shop-web (production changes: these three only)
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
