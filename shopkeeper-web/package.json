{
  "name": "shop-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:theme": "npm test -w @shopnod/theme",
    "test:e2e": "npm test -w shopnod-e2e",
    "types": "python ../backend/scripts/gen_openapi.py && npm run generate -w @shopnod/shared-types",
    "types:check": "python ../backend/scripts/gen_openapi.py && npm run generate -w @shopnod/shared-types && git diff --exit-code packages/shared-types"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@serwist/next": "9.2.1",
    "@shopnod/shared-types": "*",
    "@shopnod/theme": "*",
    "@tanstack/react-query": "5.90.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html5-qrcode": "2.3.8",
    "leaflet": "1.9.4",
    "lucide-react": "0.544.0",
    "next": "15.5.9",
    "next-intl": "4.3.9",
    "next-themes": "0.4.6",
    "qrcode.react": "4.2.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-hook-form": "7.62.0",
    "react-leaflet": "5.0.0",
    "recharts": "2.15.4",
    "serwist": "9.2.1",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.18.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
